# Copy these into Render > Environment (Add from .env). NEVER commit real keys to GitHub.

# --- secrets ---
GEMINI_API_KEYS=<gemini key for answers; several allowed, comma separated>
GEMINI_TTS_KEYS=<gemini key for read-aloud; several allowed, comma separated>
GROQ_API_KEYS=<optional: groq key, enables "search the web" by voice>
YEMOT_TOKEN=<system number>:<password>
# YouTube cookies: NOT here. Add them in Render > Environment > Secret Files as cookies.txt

# --- models ---
TEXT_MODEL=gemini-3.5-flash-lite
TEXT_MODEL_FALLBACK=gemini-3.1-flash-lite
# several TTS models separated by commas: the next one is used when quota runs out
TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# --- behaviour ---
# answer length in words: detailed answers like Gemini (never below 500, maximum 1000)
MAX_WORDS=700
# number of the Yemot extension that holds the saved conversations
HISTORY_EXT=9

# --- optional, usually not needed ---
# TURN_BUDGET_MS=80000     (time limit of one answer, in milliseconds)
# INPUT_WAIT_SEC=7         (seconds to wait for 1 or 2 in the menu)
# EXTRA_INSTRUCTION=       (extra instruction for the assistant)
# SONGS_EXT=8              (music while waiting, see the README)
# SONGS_PASS=<password>
# JAMENDO_CLIENT_ID=<id>
# MEDIA_FILES=[{"n":"name","u":"https://example.com/file.mp3"}]

# --- Google services by voice (after the personal PIN) ---
# GOOGLE_CLIENT_ID=<oauth client id>
# GOOGLE_CLIENT_SECRET=<oauth client secret>
# GOOGLE_REFRESH_TOKEN=<refresh token made with ALL the scopes listed in the README>
# PERSONAL_PIN=<4 digits or more>
# PERSONAL_PHONES=<caller numbers that are asked for the PIN, comma separated>
# MAIL_CONTACTS=name=mail@example.com;name2=mail2@example.com
# GOOGLE_TZ=Asia/Jerusalem   (time zone of the calendar)
# GOOGLE_EXTRA=off           (switches off chat, calendar, contacts, tasks, docs and sheets tools)
# CHAT_SEND_MAX=5            CAL_DEFAULT_MIN=60

# --- uploads to Drive (server memory) ---
# DRIVE_PARALLEL=1        (uploads at the same time; 1 is safe for a small server, raise only if there is memory to spare)
# SHEET_MAX_TRIES=2       (a sheet row cut by a server restart is retried this many times in total, then marked as failed)
# DRIVE_MAX_HEIGHT=480    (lower video quality = less memory, disk and time; default 720)
